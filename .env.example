# Nusxasini .env nomi bilan saqlang. Haqiqiy sirlarni Git'ga yubormang.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=tsh_ariza_db
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=24h
CORS_ORIGIN=http://localhost:3000
APP_BASE_URL=http://localhost:3000
MAX_FILE_SIZE=10485760

# Faqat birinchi production o'rnatishda true qiling, keyin false ga qaytaring.
SEED_DEFAULT_USERS=false
SEED_ADMIN_PASSWORD=replace-with-a-strong-initial-admin-password
SEED_USER_PASSWORD=replace-with-a-strong-initial-user-password
